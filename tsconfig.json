{
		"compilerOptions": {
				"target": "esnext",
				"module": "nodenext",
				"rewriteRelativeImportExtensions": true,
				"erasableSyntaxOnly": true,
				"verbatimModuleSyntax": true,
				"noEmit": true,
				"strict": true,
				"skipLibCheck": true,
				"types": ["bun"]
		},
		"include": ["**/*.ts", "**/*.d.ts"]
}
